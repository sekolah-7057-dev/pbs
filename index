<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#102b46">
<title>PBS | Platform Bestari Sekolah</title>
<style>
:root{--navy:#102b46;--navy2:#173c5b;--teal:#18b6a4;--teal2:#dff7f3;--ink:#18324b;--muted:#718397;--line:#e5edf3;--bg:#f4f8fb;--white:#fff;--gold:#f4b84c;--shadow:0 8px 28px rgba(16,43,70,.055}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--bg);color:var(--ink)}button{font:inherit;cursor:pointer}#app{min-height:100vh;display:flex}
.sidebar{width:248px;background:var(--navy);color:#e8f2f8;position:fixed;inset:0 auto 0 0;display:flex;flex-direction:column;padding:22px 15px;z-index:20;transition:transform .22s ease}
.brand{display:flex;align-items:center;gap:12px;padding:7px 10px 24px;border-bottom:1px solid rgba(255,255,255,.1)}.brand-mark{width:43px;height:43px;border-radius:14px;background:linear-gradient(145deg,#26c8b7,#148d9a);display:grid;place-items:center;color:#fff;font-weight:900;font-size:16px;box-shadow:0 6px 18px rgba(24,182,164,.2)}.brand-name{font-weight:800;letter-spacing:.2px;font-size:15px}.brand-sub{font-size:10px;color:#a8c2d4;margin-top:3px;letter-spacing:.8px;text-transform:uppercase}
.school-chip{margin:17px 7px 22px;padding:11px 12px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.08);border-radius:12px}.school-chip small{display:block;color:#9cb7c9;font-size:10px;text-transform:uppercase;letter-spacing:1px;margin-bottom:5px}.school-chip strong{font-size:12px;font-weight:650}.nav-label{font-size:10px;color:#8da9bc;letter-spacing:1.4px;text-transform:uppercase;padding:0 12px 9px}.nav-list{display:grid;gap:5px}.nav-btn{display:flex;align-items:center;gap:12px;border:0;background:transparent;color:#bdcfdd;text-align:left;padding:11px 12px;border-radius:10px;font-size:13px;transition:.15s}.nav-btn:hover{background:rgba(255,255,255,.07);color:#fff}.nav-btn.active{background:rgba(24,182,164,.17);color:#62e0d1;font-weight:700}.nav-icon{width:20px;text-align:center;font-size:16px}.sidebar-bottom{margin-top:auto;padding:13px 10px 4px;border-top:1px solid rgba(255,255,255,.1);font-size:11px;color:#90aabd;line-height:1.6}
.main{margin-left:248px;width:calc(100% - 248px);min-width:0}.topbar{height:72px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 34px;position:sticky;top:0;z-index:10}.top-left{display:flex;align-items:center;gap:12px}.menu-toggle{display:none;border:1px solid var(--line);background:#fff;border-radius:9px;padding:8px 10px;color:var(--ink)}.crumb{font-size:12px;color:var(--muted)}.crumb b{color:var(--ink)}.top-right{display:flex;align-items:center;gap:12px}.year-pill{border:1px solid var(--line);background:#f8fbfd;border-radius:9px;padding:8px 12px;font-size:12px;color:#51677b}.admin-pill{display:flex;align-items:center;gap:8px;background:#f2f8fa;padding:6px 10px;border-radius:30px;font-size:12px}.admin-dot{width:8px;height:8px;border-radius:50%;background:#1db79f;box-shadow:0 0 0 3px #d8f4ee}
.content{max-width:1500px;margin:auto;padding:30px 34px 42px}.page-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:24px}.eyebrow{color:#159b91;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:1.5px}.page-heading h1{font-size:25px;letter-spacing:-.6px;margin:7px 0 8px;color:var(--navy)}.page-heading p{margin:0;color:var(--muted);font-size:13px;line-height:1.5}.date-note{font-size:12px;color:var(--muted);padding:9px 12px;border:1px solid var(--line);border-radius:10px;background:#fff;white-space:nowrap}
.hero{background:linear-gradient(120deg,#102b46 0%,#174765 68%,#167b82 100%);color:#fff;border-radius:18px;padding:26px 28px;position:relative;overflow:hidden;box-shadow:var(--shadow);margin-bottom:20px}.hero:after{content:"";position:absolute;width:270px;height:270px;border:1px solid rgba(255,255,255,.09);border-radius:50%;right:-85px;top:-120px;box-shadow:0 0 0 35px rgba(255,255,255,.025),0 0 0 75px rgba(255,255,255,.025)}.hero-inner{position:relative;z-index:1;max-width:660px}.hero-tag{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:#87e4d9;font-weight:800}.hero h2{font-size:23px;line-height:1.3;margin:10px 0 8px;letter-spacing:-.4px}.hero p{font-size:13px;color:#c2d7e5;line-height:1.65;margin:0;max-width:620px}.hero-accent{display:flex;gap:8px;margin-top:19px}.hero-accent span{height:4px;width:30px;border-radius:5px;background:#23c4b1}.hero-accent span:nth-child(2){background:#f4bd57;width:15px}.hero-accent span:nth-child(3){background:#7ca9d1;width:15px}
.section-head{display:flex;align-items:center;justify-content:space-between;margin:25px 0 13px}.section-head h2{font-size:15px;margin:0;color:var(--navy)}.section-head small{font-size:11px;color:var(--muted)}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.stat-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:17px;box-shadow:var(--shadow);min-height:112px}.stat-top{display:flex;justify-content:space-between;align-items:center}.stat-label{font-size:11px;color:var(--muted);font-weight:650}.stat-icon{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:var(--teal2);color:#159b91;font-size:16px}.stat-value{font-size:24px;font-weight:800;color:var(--navy);margin-top:13px;letter-spacing:-.5px}.stat-foot{font-size:10px;color:var(--muted);margin-top:5px}
.module-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.module-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px;min-height:155px;cursor:pointer;transition:transform .15s,border-color .15s,box-shadow .15s;box-shadow:var(--shadow)}.module-card:hover{transform:translateY(-2px);border-color:#a6ded8;box-shadow:0 12px 26px rgba(16,43,70,.08)}.module-card-top{display:flex;align-items:center;justify-content:space-between}.module-icon{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;font-size:18px;background:#e6f7f5}.module-icon.blue{background:#e8f1fc}.module-icon.amber{background:#fff5df}.module-icon.purple{background:#f0ecff}.module-icon.rose{background:#fff0ef}.module-arrow{color:#9aabba;font-size:17px}.module-card h3{margin:14px 0 5px;font-size:13px;color:var(--navy)}.module-card p{margin:0;color:var(--muted);font-size:11px;line-height:1.55}.module-meta{margin-top:12px;color:#139b91;font-size:10px;font-weight:750;letter-spacing:.3px}
.lower-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:14px;margin-top:20px}.panel{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px;box-shadow:var(--shadow)}.panel-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.panel-title h3{font-size:13px;margin:0;color:var(--navy)}.panel-title span{font-size:10px;color:var(--muted)}.quick-list{display:grid;gap:10px}.quick-item{display:flex;align-items:center;gap:11px;padding:10px;border:1px solid #edf2f6;border-radius:10px}.quick-symbol{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;background:#f1f7fa;font-size:14px}.quick-item strong{display:block;font-size:11px}.quick-item small{display:block;font-size:10px;color:var(--muted);margin-top:3px}.system-list{display:grid;gap:0}.system-row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid #edf2f6;font-size:11px}.system-row:last-child{border-bottom:0}.status{color:#14998c;font-weight:750}.status.pending{color:#d3992c}.footer{padding:25px 0 0;text-align:center;color:#94a4b3;font-size:10px;line-height:1.6}
.view-placeholder{display:none}.mobile-overlay{display:none}
@media(max-width:1100px){.stats{grid-template-columns:repeat(2,1fr)}.module-grid{grid-template-columns:repeat(2,1fr)}.content{padding:25px}}
@media(max-width:760px){.sidebar{transform:translateX(-100%)}.sidebar.open{transform:translateX(0)}.mobile-overlay.show{display:block;position:fixed;inset:0;background:rgba(10,24,39,.42);z-index:15}.main{margin-left:0;width:100%}.menu-toggle{display:inline-block}.topbar{height:62px;padding:0 17px}.content{padding:22px 16px 32px}.page-heading{flex-direction:column}.date-note{align-self:flex-start}.hero{padding:23px 20px}.hero h2{font-size:20px}.lower-grid{grid-template-columns:1fr}.module-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.module-card{padding:14px;min-height:155px}.module-card h3{font-size:12px}.top-right{gap:8px}.admin-pill{padding:6px 8px}.year-pill{display:none}}
@media(max-width:430px){.stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.stat-card{padding:13px;min-height:102px}.stat-value{font-size:21px}.module-grid{grid-template-columns:1fr 1fr}.page-heading h1{font-size:22px}.hero h2{font-size:18px}.brand-name{font-size:14px}}
</style>
</head>
<body>
<div id="app">
  <aside class="sidebar" id="sidebar">
    <div class="brand"><div class="brand-mark">PBS</div><div><div class="brand-name">Platform Bestari</div><div class="brand-sub">Sekolah · Analisis · Murid</div></div></div>
    <div class="school-chip"><small>Institusi</small><strong>SK Kimanis, Papar<br>XBA6115</strong></div>
    <div class="nav-label">Menu utama</div>
    <nav class="nav-list" aria-label="Navigasi PBS">
      <button class="nav-btn active" data-view="dashboard"><span class="nav-icon">⌂</span>Dashboard</button>
      <button class="nav-btn" data-view="students"><span class="nav-icon">♙</span>Pengurusan Murid</button>
      <button class="nav-btn" data-view="academic"><span class="nav-icon">▤</span>Analisis Akademik</button>
      <button class="nav-btn" data-view="intervention"><span class="nav-icon">◎</span>Intervensi</button>
      <button class="nav-btn" data-view="attendance"><span class="nav-icon">◷</span>Kehadiran</button>
      <button class="nav-btn" data-view="reports"><span class="nav-icon">▧</span>Laporan</button>
      <button class="nav-btn" data-view="settings"><span class="nav-icon">⚙</span>Tetapan Sistem</button>
    </nav>
    <div class="sidebar-bottom">PBS · Platform Bestari Sekolah<br>Versi frontend awal · GitHub</div>
  </aside>
  <div class="mobile-overlay" id="overlay"></div>
  <main class="main">
    <header class="topbar"><div class="top-left"><button class="menu-toggle" id="menuToggle" aria-label="Buka menu">☰</button><div class="crumb">PBS / <b id="crumbTitle">Dashboard</b></div></div><div class="top-right"><div class="year-pill">Tahun persekolahan <b>2026</b></div><div class="admin-pill"><span class="admin-dot"></span><span>Admin</span></div></div></header>
    <div class="content" id="content">
      <div class="page-heading"><div><div class="eyebrow">Platform Bestari Sekolah</div><h1>Dashboard Utama</h1><p>Pusat pemantauan dan analisis kemenjadian murid.</p></div><div class="date-note" id="todayLabel">Paparan ringkasan</div></div>
      <section class="hero"><div class="hero-inner"><div class="hero-tag">Satu platform · Pelbagai analisis</div><h2>Satu Platform, Pelbagai Analisis,<br>Kemenjadian Murid</h2><p>Data sekolah disusun untuk membantu pemantauan, mengenal pasti keperluan murid dan menyokong tindakan yang lebih bermakna.</p><div class="hero-accent"><span></span><span></span><span></span></div></div></section>
      <div class="section-head"><h2>Ringkasan PBS</h2><small>Ringkasan akan dipautkan kepada data sebenar</small></div>
      <section class="stats"><div class="stat-card"><div class="stat-top"><span class="stat-label">Jumlah Murid</span><span class="stat-icon">♙</span></div><div class="stat-value">—</div><div class="stat-foot">Menunggu sambungan data</div></div><div class="stat-card"><div class="stat-top"><span class="stat-label">Kelas</span><span class="stat-icon">▦</span></div><div class="stat-value">—</div><div class="stat-foot">Rekod kelas sekolah</div></div><div class="stat-card"><div class="stat-top"><span class="stat-label">Data Akademik</span><span class="stat-icon">▤</span></div><div class="stat-value">—</div><div class="stat-foot">PBD · UASA · Headcount</div></div><div class="stat-card"><div class="stat-top"><span class="stat-label">Intervensi Aktif</span><span class="stat-icon">◎</span></div><div class="stat-value">—</div><div class="stat-foot">Pemantauan murid</div></div></section>
      <div class="section-head"><h2>Modul PBS</h2><small>Pilih modul untuk membuka ruang kerja</small></div>
      <section class="module-grid">
        <article class="module-card" data-view="students"><div class="module-card-top"><div class="module-icon">♙</div><span class="module-arrow">↗</span></div><h3>Pengurusan Murid</h3><p>Profil, maklumat asas, kelas dan penempatan murid.</p><div class="module-meta">DATA MURID</div></article>
        <article class="module-card" data-view="academic"><div class="module-card-top"><div class="module-icon blue">▤</div><span class="module-arrow">↗</span></div><h3>Analisis Akademik</h3><p>PBD, UASA, headcount dan perkembangan pencapaian.</p><div class="module-meta">ANALISIS PRESTASI</div></article>
        <article class="module-card" data-view="intervention"><div class="module-card-top"><div class="module-icon amber">◎</div><span class="module-arrow">↗</span></div><h3>Intervensi</h3><p>Kenal pasti keperluan, tindakan dan perkembangan murid.</p><div class="module-meta">TINDAKAN SUSULAN</div></article>
        <article class="module-card" data-view="attendance"><div class="module-card-top"><div class="module-icon purple">◷</div><span class="module-arrow">↗</span></div><h3>Kehadiran</h3><p>Rekod kehadiran dan pemantauan pola ketidakhadiran.</p><div class="module-meta">KEHADIRAN MURID</div></article>
        <article class="module-card" data-view="reports"><div class="module-card-top"><div class="module-icon rose">▧</div><span class="module-arrow">↗</span></div><h3>Laporan</h3><p>Rumusan, laporan dan eksport dapatan berasaskan data.</p><div class="module-meta">PELAPORAN</div></article>
        <article class="module-card" data-view="settings"><div class="module-card-top"><div class="module-icon blue">⚙</div><span class="module-arrow">↗</span></div><h3>Tetapan Sistem</h3><p>Konfigurasi, struktur data dan pengurusan sistem.</p><div class="module-meta">ADMINISTRASI PBS</div></article>
      </section>
      <div class="lower-grid"><section class="panel"><div class="panel-title"><h3>Akses pantas</h3><span>Modul utama</span></div><div class="quick-list"><div class="quick-item" data-view="students"><div class="quick-symbol">♙</div><div><strong>Data dan profil murid</strong><small>Pengurusan maklumat murid</small></div></div><div class="quick-item" data-view="academic"><div class="quick-symbol">▤</div><div><strong>Analisis pencapaian</strong><small>Data akademik dan perkembangan</small></div></div><div class="quick-item" data-view="intervention"><div class="quick-symbol">◎</div><div><strong>Senarai tindakan intervensi</strong><small>Pemantauan dan susulan</small></div></div></div></section><section class="panel"><div class="panel-title"><h3>Status ruang sistem</h3><span>Frontend</span></div><div class="system-list"><div class="system-row"><span>Antaramuka PBS</span><span class="status">● SEDIA</span></div><div class="system-row"><span>Reka bentuk responsif</span><span class="status">● AKTIF</span></div><div class="system-row"><span>Google Sheets / GAS</span><span class="status pending">○ BELUM DIPAUT</span></div><div class="system-row"><span>Data dashboard</span><span class="status pending">○ MENUNGGU API</span></div></div></section></div>
      <footer class="footer">PBS – Platform Bestari Sekolah · SK Kimanis, Papar · XBA6115<br>Satu Platform, Pelbagai Analisis, Kemenjadian Murid</footer>
    </div>
  </main>
</div>
<script>
(function(){
  const sidebar=document.getElementById('sidebar'),overlay=document.getElementById('overlay'),menu=document.getElementById('menuToggle');
  const titleMap={dashboard:'Dashboard',students:'Pengurusan Murid',academic:'Analisis Akademik',intervention:'Intervensi',attendance:'Kehadiran',reports:'Laporan',settings:'Tetapan Sistem'};
  function closeMenu(){sidebar.classList.remove('open');overlay.classList.remove('show')}
  menu.addEventListener('click',()=>{sidebar.classList.toggle('open');overlay.classList.toggle('show')});overlay.addEventListener('click',closeMenu);
  function navigate(view){if(!titleMap[view])return;document.querySelectorAll('.nav-btn').forEach(b=>b.classList.toggle('active',b.dataset.view===view));document.getElementById('crumbTitle').textContent=titleMap[view];closeMenu();if(view==='dashboard'){document.querySelector('.page-heading h1').textContent='Dashboard Utama';document.querySelector('.page-heading p').textContent='Pusat pemantauan dan analisis kemenjadian murid.';document.getElementById('content').scrollTop=0;window.scrollTo({top:0,behavior:'smooth'});return;}document.querySelector('.page-heading h1').textContent=titleMap[view];document.querySelector('.page-heading p').textContent='Ruang modul '+titleMap[view]+'.';document.querySelector('.hero h2').innerHTML=titleMap[view];document.querySelector('.hero p').textContent='Modul ini akan menggunakan data PBS yang sama dan dibangunkan mengikut aliran kerja sekolah. Sambungan data sebenar belum diaktifkan.';document.querySelector('.section-head h2').textContent='Ruang '+titleMap[view];document.querySelector('.section-head small').textContent='Modul dipilih';document.querySelector('.stats').style.display='none';document.querySelector('.module-grid').style.display='none';document.querySelector('.lower-grid').style.display='none';let old=document.getElementById('moduleNotice');if(!old){old=document.createElement('section');old.id='moduleNotice';old.className='panel';old.style.marginTop='20px';document.querySelector('.hero').after(old)}old.innerHTML='<div class="panel-title"><h3>'+titleMap[view]+'</h3><span>Ruang kerja modul</span></div><p style="font-size:13px;color:#718397;line-height:1.7;margin:0">Antaramuka modul ini akan diisi dengan fungsi sebenar dan disambungkan kepada backend PBS. Tiada data contoh dipaparkan sebagai data sekolah.</p><div style="margin-top:15px;background:#f3f8fb;border:1px solid #e5edf3;border-radius:10px;padding:12px;font-size:12px;color:#51677b">Status: Menunggu pembangunan modul dan sambungan API.</div>';window.scrollTo({top:0,behavior:'smooth'});}
  document.querySelectorAll('[data-view]').forEach(el=>el.addEventListener('click',()=>navigate(el.dataset.view)));
  document.getElementById('todayLabel').textContent=new Intl.DateTimeFormat('ms-MY',{dateStyle:'medium'}).format(new Date());
  document.querySelectorAll('.nav-btn').forEach(b=>b.addEventListener('click',()=>{const view=b.dataset.view;if(view==='dashboard'){document.querySelector('.stats').style.display='grid';document.querySelector('.module-grid').style.display='grid';document.querySelector('.lower-grid').style.display='grid';const notice=document.getElementById('moduleNotice');if(notice)notice.remove();document.querySelector('.section-head h2').textContent='Ringkasan PBS';document.querySelector('.section-head small').textContent='Ringkasan akan dipautkan kepada data sebenar';document.querySelector('.hero h2').innerHTML='Satu Platform, Pelbagai Analisis,<br>Kemenjadian Murid';document.querySelector('.hero p').textContent='Data sekolah disusun untuk membantu pemantauan, mengenal pasti keperluan murid dan menyokong tindakan yang lebih bermakna.';}}));
})();
</script>
</body>
</html>
